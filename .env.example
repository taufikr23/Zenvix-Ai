# Salin menjadi .env dan isi password acak, atau jalankan scripts/setup-env.ps1.
POSTGRES_DB=documind
DB_USERNAME=documind
DB_PASSWORD=
DB_PORT=5433
BACKEND_PORT=8080
MAX_UPLOAD_SIZE=10MB
MAX_REQUEST_SIZE=11MB
# Chat AI membutuhkan GEMINI_API_KEY.

# Secret Base64 minimal 32 byte acak. setup-env.ps1 akan membuatnya.
JWT_SECRET=
JWT_ISSUER=documind-ai
JWT_AUDIENCE=documind-api
JWT_ACCESS_TOKEN_SECONDS=900

# Jumlah dokumen tersimpan per pengguna (termasuk penghapusan tertunda).
MAX_DOCUMENTS_PER_USER=50

# Ekstraksi Java dan chunking; ukuran chunk dihitung dalam Unicode code point.
PROCESSING_ENABLED=true
PROCESSING_POLL_DELAY_MS=1000
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_EXTRACTED_CHARACTERS=2000000
MAX_CHUNKS=3000
PROCESSING_TIMEOUT_SECONDS=60

# Isi key di .env lokal. Embedding hanya diperlukan untuk fitur dokumen.
GEMINI_API_KEY=
EMBEDDING_ENABLED=false
EMBEDDING_TIMEOUT_MS=20000
EMBEDDING_POLL_DELAY_MS=1000
EMBEDDING_DAILY_CHARACTERS=200000
EMBEDDING_USER_DAILY_CHARACTERS=50000

# Aktifkan chat dengan GEMINI_API_KEY; tidak memerlukan EMBEDDING_ENABLED.
CHAT_ENABLED=false
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
CHAT_TIMEOUT_MS=90000
CHAT_MAX_OUTPUT_TOKENS=1024
CHAT_TOP_K=5
CHAT_MIN_SIMILARITY=0.45
CHAT_MAX_CONTEXT_CHARACTERS=6000
CHAT_MAX_TURNS=50
CHAT_MAX_CONVERSATIONS=100
CHAT_DAILY_REQUESTS=500
CHAT_USER_DAILY_REQUESTS=50
CHAT_DAILY_CHARACTERS=10000000
CHAT_USER_DAILY_CHARACTERS=2000000

# Tahap 7 — antarmuka web lokal
FRONTEND_PORT=3000
FRONTEND_MAX_UPLOAD_MB=10
